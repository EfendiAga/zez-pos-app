{
  "name": "zez-pos",
  "productName": "ZEZ-POS",
  "version": "1.0.6",
  "description": "ZEZ-POS Fiscal Point of Sale System",
  "author": "ZEZ",
  "private": true,
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "bridge": "tsx server/fiscalBridge.ts",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main.cjs --external:electron --external:serialport && esbuild electron/preload.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload.cjs --external:electron",
    "electron:pack": "npm run build && npm run build:electron && electron-builder --dir",
    "electron:build": "npm run build && npm run build:electron && electron-builder --win",
    "electron:release": "npm run build && npm run build:electron && electron-builder --win --publish always",
    "electron:portable": "npm run build && npm run build:electron && electron-builder --win portable",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "serialport": "^13.0.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.zezpos.app",
    "productName": "ZEZ-POS",
    "publish": {
      "provider": "github",
      "owner": "efendiaga",
      "repo": "zez-pos-app"
    },
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "node_modules/@serialport/**/*",
      "node_modules/serialport/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@serialport/**/*",
      "**/node_modules/serialport/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZEZ-POS"
    },
    "portable": {
      "artifactName": "ZEZ-POS-Portable.exe"
    }
  }
}
